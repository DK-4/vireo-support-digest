# Copy to .env and fill in. Never commit .env.
# Provider-agnostic: works with Anthropic, OpenAI, or any OpenAI-compatible
# endpoint (Gemini included, via Google's compatibility layer).

# --- Option A: Gemini (via Google's OpenAI-compatible endpoint) ---
LLM_PROVIDER=openai
LLM_API_KEY= api_key                   # your Gemini key from https://aistudio.google.com/apikey
LLM_MODEL=gemini-2.5-flash-lite  # cheapest current stable model, good for classification
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Option B: Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=<model string>
# LLM_BASE_URL=https://api.anthropic.com

# --- Option C: OpenAI ---
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=<model string>
# LLM_BASE_URL=https://api.openai.com/v1

LLM_TIMEOUT=60
